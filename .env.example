# Host.it account credentials
HOST_USERNAME=your_hostit_username
HOST_PASSWORD=your_hostit_password

# Host.it authentication endpoint
HOST_SSO_URL=https://sso.host.it/cas/v1/tickets

# Host.it DNS API
HOST_API_BASE_URL=https://api.host.it/public

# DNS zone managed by Host.it
#
# Example:
#   HOST_DNS_ZONE=example.com
#
# This is the authoritative zone in which Certbot challenge
# records will be created.
HOST_DNS_ZONE=example.com
